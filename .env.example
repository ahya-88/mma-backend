# Path file database SQLite. Di hosting dengan persistent volume/disk (Railway, Fly.io, dst.),
# arahkan ke folder volume tersebut supaya data TIDAK hilang saat redeploy, mis: /data/cashless.db
# Lokal/dev: boleh dikosongkan, default-nya ./cashless.db di folder backend ini.
DATABASE_PATH=./cashless.db

# WAJIB diganti dengan string acak yang panjang di produksi (mis: openssl rand -hex 32).
# Jangan pernah pakai nilai default di kode saat online.
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang-di-produksi"

# Kebanyakan platform hosting (Railway, Render, Fly.io) mengisi ini otomatis — boleh dikosongkan.
PORT=8080
