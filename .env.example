# PostgreSQL connection string. Neon requires SSL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&channel_binding=require

# WAJIB diganti dengan string acak yang panjang di produksi (mis: openssl rand -hex 32).
# Jangan pernah pakai nilai default di kode saat online.
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang-di-produksi"

# Comma-separated origins permitted for cross-origin API access. Set production frontend origins explicitly.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Demo fixtures are disabled unless explicitly enabled for a non-production environment.
DEMO_MODE=false

# Number of trusted reverse-proxy hops in front of the app (for example, 1 on Railway).
TRUST_PROXY_HOPS=0

# Most hosting platforms (Railway, Render, Fly.io) provide this automatically.
PORT=4000
